# Ficheiro: backend/.env.example | Função: variáveis de ambiente do servidor (P9)
NODE_ENV=production
PORT=3000
APP_VERSION=0.1.0

# Supabase — URL pública + service_role para operações privilegiadas
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS (lista separada por vírgula; * = qualquer origem)
CORS_ORIGINS=https://app.ridefriend.ao,https://ridefriend.ao

# AfricasTalking (SMS — backup do SOS, OTP em mercados sem Twilio)
AT_USERNAME=sandbox
AT_API_KEY=atsk_...
AT_SENDER_ID=RideFriend

# CallMeBot (notificação de deploy via WhatsApp)
CALLMEBOT_PHONE=+244912345678
CALLMEBOT_API_KEY=123456
