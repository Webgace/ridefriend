# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SMS Providers — CLIENT (sms.service.ts, PL3)
# Atenção: estas chaves ficam expostas no bundle. Em produção, mover o envio
# de SMS para o backend e remover as variáveis EXPO_PUBLIC_* abaixo.
EXPO_PUBLIC_AFRICAS_TALKING_API_KEY=
EXPO_PUBLIC_AFRICAS_TALKING_USERNAME=
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=
EXPO_PUBLIC_TWILIO_FROM_NUMBER=
EXPO_PUBLIC_TERMII_API_KEY=

# SMS Providers — BACKEND (sms.backend.service.ts, P9 — NÃO expostas ao cliente)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TERMII_API_KEY=

# Mapas — Google Maps (opcional, só BR e PT)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# App
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=2.1.0
