{
  "expo": {
    "name": "RideFriend",
    "slug": "ridefriend",
    "owner": "tiibs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1F38"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideFriend needs access to your location to show nearby drivers and passengers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RideFriend needs access to your location to show nearby drivers and passengers.",
        "NSCameraUsageDescription": "RideFriend needs camera access for profile pictures and vehicle photos.",
        "NSPhotoLibraryUsageDescription": "RideFriend needs access to your photo library to upload images.",
        "NSPhotoLibraryAddUsageDescription": "RideFriend needs access to save photos to your photo library."
      },
      "bundleIdentifier": "com.friendride.app",
      "scheme": "ridefriend"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1F38"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.friendride.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "ridefriend"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ridefriend",
    "extra": {
      "apiBaseUrl": "http://72.61.45.31/ridefriend",
      "eas": {
        "projectId": "1f47c628-5760-4a75-9abf-ccdc9fd9ab48"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RideFriend to access your location to show nearby drivers and passengers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D97706"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RideFriend to access your photos.",
          "cameraPermission": "Allow RideFriend to access your camera."
        }
      ]
    ]
  }
}
