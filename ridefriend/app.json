{
  "expo": {
    "name": "RideFriend",
    "slug": "ridefriend",
    "owner": "tiibs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1F38"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "RideFriend needs access to your location to show nearby drivers and passengers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RideFriend needs access to your location to show nearby drivers and passengers.",
        "NSCameraUsageDescription": "RideFriend needs camera access for profile pictures and vehicle photos.",
        "NSPhotoLibraryUsageDescription": "RideFriend needs access to your photo library to upload images.",
        "NSPhotoLibraryAddUsageDescription": "RideFriend needs access to save photos to your photo library.",
        "NSContactsUsageDescription": "RideFriend uses your contacts to suggest which of your friends are already on the app, so you can quickly add them to your trusted network."
      },
      "bundleIdentifier": "com.friendride.app",
      "scheme": "ridefriend"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1F38"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ],
      "package": "com.friendride.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "ridefriend"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ridefriend",
    "extra": {
      "apiBaseUrl": "http://72.61.45.31/ridefriend",
      "eas": {
        "projectId": "1f47c628-5760-4a75-9abf-ccdc9fd9ab48"
      },
      "googleIosClientId": "1027420415056-o7pglmie6v04nmf18p5b802nsjau36tf.apps.googleusercontent.com",
      "googleAndroidClientId": "1027420415056-08gdkrher0svvdpj7o0urihuh13j194g.apps.googleusercontent.com",
      "googleWebClientId": "1027420415056-afhi86rfck1bsmert1uokrftnf5vj509.apps.googleusercontent.com"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RideFriend to access your location to show nearby drivers and passengers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D97706"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RideFriend to access your photos.",
          "cameraPermission": "Allow RideFriend to access your camera."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "RideFriend uses your contacts to suggest which of your friends are already on the app, so you can quickly add them to your trusted network."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1027420415056-o7pglmie6v04nmf18p5b802nsjau36tf"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f47c628-5760-4a75-9abf-ccdc9fd9ab48"
    }
  }
}
