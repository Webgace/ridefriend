{
  "name": "ridefriend-v2",
  "version": "2.0.0",
  "description": "RideFriend v2 - Multi-market ride sharing application",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@expo-google-fonts/sora": "^0.2.3",
    "@expo/metro-runtime": "~3.2.3",
    "@react-navigation/bottom-tabs": "^6",
    "@react-navigation/native": "^6",
    "@react-navigation/stack": "^6",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "expo": "^51",
    "expo-constants": "^16",
    "expo-font": "^12",
    "expo-haptics": "^13",
    "expo-image-picker": "^15",
    "expo-linear-gradient": "^13",
    "expo-localization": "^15",
    "expo-location": "^17",
    "expo-notifications": "^0.27",
    "expo-secure-store": "^13",
    "i18next": "^23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^13",
    "react-native": "^0.74",
    "react-native-gesture-handler": "^2",
    "react-native-maps": "^1",
    "react-native-mmkv": "^2",
    "react-native-phone-number-input": "^2",
    "react-native-reanimated": "^3",
    "react-native-safe-area-context": "^4",
    "react-native-screens": "^4",
    "react-native-web": "~0.19.10",
    "zustand": "^4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29",
    "@types/react": "^18",
    "@types/react-native": "^0.73",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "^11",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-native": "^4",
    "jest": "^29",
    "jest-expo": "^51",
    "prettier": "^3",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "moduleNameMapper": {
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@types/(.*)$": "<rootDir>/src/types/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@constants/(.*)$": "<rootDir>/src/constants/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@i18n/(.*)$": "<rootDir>/src/i18n/$1",
      "^@screens/(.*)$": "<rootDir>/src/screens/$1",
      "^@navigation/(.*)$": "<rootDir>/src/navigation/$1"
    }
  }
}
