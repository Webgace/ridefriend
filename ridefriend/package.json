{
  "name": "ridefriend-v2",
  "version": "2.0.0",
  "description": "RideFriend v2 - Multi-market ride sharing application",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@expo-google-fonts/sora": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/bottom-tabs": "^6",
    "@react-navigation/native": "^6",
    "@react-navigation/stack": "^6",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "expo": "~54",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^13",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-mmkv": "^2.12.2",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-native": "^4",
    "jest": "^29",
    "jest-expo": "~54.0.17",
    "prettier": "^3",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "moduleNameMapper": {
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@types/(.*)$": "<rootDir>/src/types/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@constants/(.*)$": "<rootDir>/src/constants/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@i18n/(.*)$": "<rootDir>/src/i18n/$1",
      "^@screens/(.*)$": "<rootDir>/src/screens/$1",
      "^@navigation/(.*)$": "<rootDir>/src/navigation/$1"
    }
  }
}
